---
import YorhaPixel from "./YorhaPixel.astro";
import {
  SITE,
  FOOTER_SITE_LINKS,
  ELSEWHERE_LINKS,
  externalLinkAttrs,
  isExternal,
} from "../../lib/site";

// Build stamp. The line this replaced read "uptime 99.4% · build #1284", which
// was invented — neither number came from anywhere. A build date is something
// we actually know at build time. Live uptime is a backend concern (FEAT-204).
const built = new Date();
const buildDate = built.toISOString().slice(0, 10);
const year = built.getUTCFullYear();
---

<footer class="bg-secondary border-t border-border">
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="grid grid-cols-4 gap-6">
      <div>
        <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
          <div
            class="w-7 h-7 rounded-md text-[14px] bg-primary flex items-center justify-center font-bold font-mono text-white flex-shrink-0"
          >
            &gt;_
          </div>
          <div class="flex flex-col leading-[1.05]">
            <span class="font-bold font-mono text-foreground text-[16px]">{SITE.name}</span>
            <span class="font-mono text-muted-foreground text-[12px]"
              >.{SITE.domain.split(".").pop()}</span
            >
          </div>
        </a>
        <p class="text-[14px] font-mono text-muted-foreground mt-3 leading-[1.6]">
          {SITE.description}
        </p>
      </div>
      <div>
        <div class="text-[12px] font-mono text-muted-foreground mb-3">/site</div>
        <div class="flex flex-col gap-1.5">
          {
            FOOTER_SITE_LINKS.map((l) => (
              <a
                href={l.href}
                class="text-[14px] font-mono text-foreground/60 hover:text-foreground cursor-pointer transition-colors"
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <div class="text-[12px] font-mono text-muted-foreground mb-3">/elsewhere</div>
        <div class="flex flex-col gap-1.5">
          {
            ELSEWHERE_LINKS.map((link) => (
              <a
                href={link.href}
                class="text-[14px] font-mono text-foreground/60 hover:text-foreground transition-colors"
                {...externalLinkAttrs(link.href)}
              >
                {link.label}
                {/* The arrow is decoration; the parenthetical is what a screen
                    reader announces in its place. */}
                {isExternal(link.href) && (
                  <>
                    <span aria-hidden="true"> ↗</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </>
                )}
              </a>
            ))
          }
        </div>
      </div>
      <div
        class="flex items-center justify-center p-3 text-center"
      >
        <YorhaPixel scale={4} alt="YoRHa emblem" />
      </div>
    </div>
    <div class="mt-6 pt-4 border-t border-border flex justify-between">
      <span class="text-[13px] font-mono text-muted-foreground">
        © {year} {SITE.name} · served by k3s @ home
      </span>
      <span class="text-[13px] font-mono text-muted-foreground" style="color: #b0abab;">
        AUDENTES FORTUNA IUVAT
      </span>
      <span class="text-[13px] font-mono text-muted-foreground">
        built <time datetime={buildDate}>{buildDate}</time>
      </span>
    </div>
  </div>
</footer>
