---
// Pixel-art packet mascot. The art lives in public/packet-icon-2.png: a
// 100×100 canvas with the sprite drawn 1:1 in a 44×35 box at (21, 30). The
// canvas is cropped to that box here rather than in the file, so the PNG can
// keep being edited as-is; if the art moves or resizes on the canvas, update
// ART to match.
//
// The art faces right. A CSS animation mirrors it for the return leg of the
// caller's patrol; the cycle length comes from --pc-leg (set by Nav, the
// element that owns the patrol), so the two animations can never drift apart.
interface Props {
  /** Size of one sprite pixel in CSS px. Keep it a whole number. */
  px?: number;
  class?: string;
}
const { px = 1, class: className } = Astro.props;

const SRC = "/packet-icon-2.png";
const CANVAS = 100;
const ART = { x: 21, y: 30, w: 44, h: 35 };

const width = ART.w * px;
const height = ART.h * px;
---

<div
  class:list={["packet-sprite", className]}
  style={`width:${width}px;height:${height}px;--bob:-${px}px`}
  aria-hidden="true"
>
  <div class="packet-art">
    <img
      src={SRC}
      alt=""
      width={CANVAS * px}
      height={CANVAS * px}
      style={`left:-${ART.x * px}px;top:-${ART.y * px}px`}
      draggable="false"
    />
  </div>
</div>

<style>
  /* Three layers so the two transforms never fight: the outer box bobs, the
     middle box is cropped to the art (so mirroring it flips around the art's
     own centre, not the canvas's) and the image sits offset inside it. */
  .packet-sprite {
    position: relative;
    animation: packet-bob 0.4s steps(2, jump-none) infinite;
  }
  .packet-art {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    animation: packet-face calc(var(--pc-leg, 4.5s) * 2) steps(2, jump-none)
      infinite;
  }
  /* pixelated keeps hard pixel edges under fractional display scaling (e.g.
     Windows at 125%), where the default smoothing blurs the art. */
  .packet-art img {
    position: absolute;
    max-width: none;
    image-rendering: pixelated;
  }

  /* Freeze the bob and the facing when an ancestor (the nav's pause button)
     is paused, so the mascot stops looking where it stopped. */
  :global(.is-paused) .packet-sprite,
  :global(.is-paused) .packet-art {
    animation-play-state: paused;
  }

  /* The bob is a stepped 2-frame hop; the facing flip happens once per full
     there-and-back patrol — steps(2, jump-none) holds the from-value for the
     outbound leg and the to-value for the return. */
  @keyframes packet-bob {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(var(--bob));
    }
  }
  @keyframes packet-face {
    from {
      transform: none;
    }
    to {
      transform: scaleX(-1);
    }
  }

  /* No patrol under reduced motion, so there is no direction to track: hold
     the right-facing frame. */
  @media (prefers-reduced-motion: reduce) {
    .packet-sprite,
    .packet-art {
      animation: none;
    }
  }
</style>
