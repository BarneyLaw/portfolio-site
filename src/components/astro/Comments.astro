---
import { apiConfigured } from "../../lib/api";

interface Props {
  /** Slug the API keys comments on. Must match the entry's id, which is what
      the backend's content registry stores. */
  slug: string;
  /** False when the entry closes comments. Renders nothing. */
  enabled?: boolean;
}

const { slug, enabled = true } = Astro.props;

// Two build-time gates. Without a configured backend there is no endpoint to
// talk to, so rendering an empty section (or worse, a form) would be the same
// dead-end interaction this site spent Milestone 1 removing.
const show = enabled && apiConfigured();
---

{
  show && (
    <section
      class="mt-12 pt-8 border-t border-border"
      data-comments
      data-slug={slug}
      aria-labelledby="comments-heading"
    >
      <h2 id="comments-heading" class="font-bold font-mono text-[18px] text-foreground mb-1">
        comments
      </h2>

      <p class="text-[13px] font-mono text-muted-foreground mb-5">
        Plain text only. Be decent.
      </p>

      {/* The "view comments" control is injected by the script below rather
          than rendered here. Without JavaScript it would be a button that does
          nothing, and nothing on this page is allowed to look clickable and be
          inert. The <noscript> explains the absence instead. */}
      <div data-comments-open />

      {/* Reserved region. The status line sits above the list so an error or
          a loading message appears in a fixed place instead of pushing the
          rest of the page around as it changes. */}
      <p
        data-comments-status
        class="text-[14px] font-mono text-muted-foreground min-h-[1.5rem]"
        role="status"
        aria-live="polite"
      />

      <ol data-comments-list class="flex flex-col gap-4 mt-2" />

      <div data-comments-actions class="mt-4" />

      <noscript>
        <p class="text-[14px] font-mono text-muted-foreground">
          Comments need JavaScript — they are loaded from the site's API on request.
          The writeup above is complete without them.
        </p>
      </noscript>
    </section>
  )
}

<script>
  // Comments load on explicit intent, not on scroll. A reader who reaches the
  // end of a long article has not necessarily asked for a comment thread, and
  // this way the module and its request belong only to people who want them.
  const section = document.querySelector<HTMLElement>("[data-comments]");
  const slot = section?.querySelector<HTMLElement>("[data-comments-open]");

  if (section && slot) {
    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "text-[13px] font-mono px-3 py-1.5 rounded border border-border text-muted-foreground hover:border-primary/40 hover:text-foreground transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed";
    button.textContent = "view comments";
    // The button controls the region it fills in, and says so.
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-controls", "comments-thread");

    const list = section.querySelector("[data-comments-list]");
    list?.setAttribute("id", "comments-thread");

    button.addEventListener(
      "click",
      () => {
        button.disabled = true;
        button.setAttribute("aria-expanded", "true");

        // Dynamic import: a reader who never asks for comments never
        // downloads the module or the API client behind it.
        import("../../features/comments/mount")
          .then(({ mountComments }) => {
            button.remove();
            mountComments(section);
          })
          .catch(() => {
            // A failed chunk load must not take the article with it, and the
            // reader must be able to try again.
            button.disabled = false;
            button.setAttribute("aria-expanded", "false");
            const status = section.querySelector("[data-comments-status]");
            if (status) status.textContent = "Comments could not be loaded.";
          });
      },
      { once: false },
    );

    slot.append(button);
  }
</script>
