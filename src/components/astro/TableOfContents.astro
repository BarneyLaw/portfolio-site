---
import type { MarkdownHeading } from "astro";

interface Props {
  /** Comes straight from `render(entry)`. Never re-parse the body: these are
      the same headings, with the same slugs, that the page actually rendered. */
  headings: MarkdownHeading[];
  /** Below this many sections a contents list is just noise. */
  minHeadings?: number;
}

const { headings, minHeadings = 4 } = Astro.props;

// Only top-level sections. h3+ would turn a reading aid into an outline, and
// these articles nest two or three levels deep.
const sections = headings.filter((h) => h.depth === 2);
const show = sections.length >= minHeadings;
---

{
  show && (
    /* <details> gives a collapsible panel with no JavaScript at all, and it is
       keyboard-operable and announced correctly for free. Closed by default so
       it never pushes the article below the fold. */
    <details class="mb-8 bg-card border border-border rounded p-4">
      <summary class="text-[13px] font-mono text-primary cursor-pointer select-none">
        // contents ({sections.length} sections)
      </summary>
      <nav aria-label="Table of contents">
        <ol class="mt-3 flex flex-col gap-1.5 list-decimal pl-5">
          {sections.map((h) => (
            <li class="text-[14px] font-mono text-muted-foreground">
              <a href={`#${h.slug}`} class="hover:text-primary transition-colors">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
