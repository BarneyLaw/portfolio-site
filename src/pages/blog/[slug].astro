---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CodeCopy from "../../components/astro/CodeCopy.astro";
import TableOfContents from "../../components/astro/TableOfContents.astro";
import { getBlogPosts, socialImageOf } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
// `headings` is Astro's own list from the rendered body — the table of
// contents is built from it rather than from a second pass over the source,
// so the two can never disagree about what sections exist.
const { Content, headings } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  image={socialImageOf(post)}
  ogType="article"
  publishedDate={post.data.date}
>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <a
      href="/blog"
      class="inline-block text-[13px] font-mono text-muted-foreground hover:text-foreground transition-colors mb-5 cursor-pointer"
    >
      ← blog
    </a>

    <div class="text-[12px] font-mono text-muted-foreground mb-2">
      {post.data.date} · {post.data.readTime} · {post.data.category}
    </div>
    <h1 class="font-bold font-mono text-[26px] text-foreground leading-snug mb-6">
      {post.data.title}
    </h1>

    <TableOfContents headings={headings} />

    <article class="mdx-content">
      <Content />
    </article>

    {/* gap: view counts + comments (Go backend via src/lib/api.ts) go here */}
  </main>

  <CodeCopy />
</Layout>
