---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Tag from "../components/astro/Tag.astro";
import profilePic from "../img/icons/ruri_thumbs_up.png";
import { ELSEWHERE_LINKS, externalLinkAttrs, isExternal } from "../lib/site";

const stack = [
  "Astro",
  "TypeScript",
  "Go",
  "Kubernetes",
  "Postgres",
  "Ansible",
  "NGINX",
  "Ubuntu Server",
];
---

<Layout title="about · packetcraft">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-8">
      <Image
        src={profilePic}
        alt="profile picture"
        class="w-48 h-48 rounded-full mb-4"
      />
      <h1 class="font-bold font-mono text-[32px] text-foreground mb-3">about</h1>
      <p class="text-[16px] font-mono text-foreground/80 leading-[1.8]">
        I'm a third year computer science student in one of the the few city states in the world.
        I have a strong interest networks, graphics and the infrastructure that makes applications possible. I like to build things, and I like to write about them. This site is a place for both.
      </p>
    </div>

    <div class="text-[16px] font-mono text-foreground/80 leading-[1.8] mb-8">
      <p>
        This site documents things I build, hardware I test, and observations I
        want to write down somewhere. It runs on a 4-node k3s cluster in my
        house and serves as both a portfolio and a way to force myself to
        document & explain things clearly.
      </p>
      <br/>
      <p>
        I also write about things that interest me on my blog, and I review many things ranging from coursework to games. If you want to get in touch,
        you can reach me via email or on GitHub.
      </p>
    </div>

    {/* Stack */}
    <div class="mb-8">
      <div class="text-[14px] font-mono text-muted-foreground mb-3">// stack (for this site)</div>
      <div class="flex flex-wrap gap-2">
        {stack.map((t) => <Tag>{t}</Tag>)}
      </div>
    </div>

    {/* Now */}
    <div
      class="bg-card border border-border border-l-[3px] border-l-primary rounded p-4 mb-8"
    >
      <div class="text-[13px] font-mono text-primary mb-2">// now</div>
      <p class="text-[15px] font-mono text-foreground/80 leading-[1.7]">
        Migrating personal services to the k3s cluster · writing obsync ·
        gaming · reading about networks, graphics, and programming languages ·
      </p>
    </div>
    <div
      class="bg-card border border-border border-l-[3px] border-l-primary rounded p-4 mb-8"
    >
     <p class="text-[15px] font-mono text-foreground/80 leading-[1.7]">
        P.S. All the artwork and images on this site are free to use for any purposes, but you may not claim or redistribute it as your own.
      </p>
    </div>

    {/* Links — real destinations from src/lib/site.ts. These were previously
        <span>s styled to look clickable, which is a dead end for anyone who
        actually tried to use them. */}
    <nav class="flex gap-5" aria-label="Elsewhere">
      {
        ELSEWHERE_LINKS.map((l) => (
          <a
            href={l.href}
            class="text-[15px] font-mono text-muted-foreground hover:text-primary transition-colors"
            {...externalLinkAttrs(l.href)}
          >
            {l.label}
            {isExternal(l.href) && (
              <>
                <span aria-hidden="true"> ↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </>
            )}
          </a>
        ))
      }
    </nav>
  </main>
</Layout>
