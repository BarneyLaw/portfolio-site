---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Cursor from "../components/astro/Cursor.astro";
import Hatch from "../components/astro/Hatch.astro";
import Tag from "../components/astro/Tag.astro";
import {
  getProjects,
  getBlogPosts,
  getReviews,
  getFeaturedPost,
} from "../lib/content";

// The feed is built from the collections rather than hand-written, so every
// card links to a page that exists and the copy can't drift from the source.
// Selection and ordering rules (drafts, future dates, the featured rule, tie
// breaking) all live in src/lib/content.ts — this page only decides layout.
const [posts, featured, projects, reviews] = await Promise.all([
  getBlogPosts(),
  getFeaturedPost(),
  getProjects(),
  getReviews(),
]);

// One card per content type, each the newest of its kind. The blog slot skips
// whatever is already in the hero above so the page never shows it twice.
// Any of these may be undefined when a collection is empty; the filter below
// drops the empty slots rather than rendering a card that links nowhere.
const topProject = projects[0];
const topPost = posts.find((p) => p.id !== featured?.id);
const topReview = reviews[0];

// Cover art on these cards is decorative: the headline and subtitle right
// beside it already say what the card is, so describing the artwork as well
// just makes a screen reader read the same thing twice. alt="" unless the
// entry deliberately supplies coverArtAlt.
const recent = [
  topProject && {
    tag: "PROJECT",
    href: `/projects/${topProject.id}`,
    label: `${topProject.data.name} — ${topProject.data.status}`,
    sub: topProject.data.meta,
    muted: false,
    coverArt: topProject.data.coverArt,
    coverAlt: topProject.data.coverArtAlt ?? "",
  },

  topPost && {
    tag: "BLOG",
    href: `/blog/${topPost.id}`,
    label: topPost.data.title,
    sub: `${topPost.data.date} · ${topPost.data.readTime} · ${topPost.data.category}`,
    muted: true,
    coverArt: topPost.data.coverArt,
    coverAlt: topPost.data.coverArtAlt ?? "",
  },

  topReview && {
    tag: "REVIEW",
    href: `/reviews/${topReview.id}`,
    label: `${topReview.data.name} — ${topReview.data.verdict}`,
    sub: topReview.data.excerpt,
    muted: true,
    coverArt: topReview.data.coverArt,
    coverAlt: topReview.data.coverArtAlt ?? "",
  },
].filter((item): item is NonNullable<typeof item> => Boolean(item));

const navCards = ["projects", "blog", "reviews"];
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12">
    {/* Hero */}
    <div class="mb-8">
      <div
        class="font-bold font-mono text-[50px] text-foreground tracking-tight leading-none"
      >
        <span class="text-primary">&gt;</span> packetcraft
        <Cursor large />
      </div>
      <div class="font-mono text-[16px] text-primary mt-3">
        networks · graphics · gaming · systems
      </div>
    </div>

    {/* Terminal whoami */}
    <div
      class="bg-[#12151f] rounded-lg px-6 py-5 font-mono text-[15px] leading-[1.8] mb-10"
    >
      <div>
        <span class="text-[#3b82f6]">me@packetcraft</span>
        <span class="text-[#8a93a6]">:~$ uname -a</span>
      </div>
      <div class="text-[#f0eada]">
        k3s · ubuntu · nginx · serving this site
      </div>
      <div class="mt-1">
        <span class="text-[#3b82f6]">me@packetcraft</span>
        <span class="text-[#8a93a6]">:~$ </span>
        <span class="text-[#f0eada]">cat ./latest</span>
        <Cursor />
      </div>
    </div>

    {/* Featured */}
    <div class="flex items-center justify-between mb-3">
      <span class="text-[16px] font-mono text-muted-foreground">// featured</span>
      <span class="text-[14px] font-mono text-muted-foreground">
        ▸ news · hardware drops · findings
      </span>
    </div>
    {
      featured && (
        <a
          href={`/blog/${featured.id}`}
          class="bg-card border border-border border-l-[3px] border-l-primary rounded-md overflow-hidden flex gap-4 p-4 mb-8 hover:border-primary/50 transition-colors cursor-pointer group"
        >
          {
            featured.data.coverArt ? (
              <Image
                src={featured.data.coverArt}
                alt={featured.data.coverArtAlt ?? ""}
                loading="eager"
                class="w-28 h-20 flex-none rounded object-cover"
              />
            ) : (
              <Hatch class="w-28 h-20 flex-none" label="cover" />
            )
          }
          <div class="flex-1 min-w-0">
            <div class="flex gap-2 items-center">
              <span class="text-[12px] font-mono text-primary border border-primary rounded px-1.5 py-0.5">
                FEATURED
              </span>
              <span class="text-[12px] font-mono text-muted-foreground">
                {featured.data.date}
              </span>
            </div>
            <div class="mt-3 font-bold font-mono text-[16px] text-foreground group-hover:text-primary transition-colors leading-snug">
              {featured.data.title}
            </div>
            <div class="mt-2 text-[14px] font-mono text-muted-foreground leading-relaxed">
              {featured.data.excerpt}
            </div>
          </div>
        </a>
      )
    }

    {/* Recent */}
    <div class="text-[16px] font-mono text-muted-foreground mb-3">// recent</div>
    <div class="flex flex-col gap-3 mb-10">
      {
        recent.map((item) => (
          <a
            href={item.href}
            class="bg-card border border-border rounded p-3 flex gap-3 hover:border-primary/40 transition-colors cursor-pointer group"
          >
            {
              item.coverArt ? (
                <Image
                  src={item.coverArt}
                  alt={item.coverAlt}
                  class="w-14 h-14 flex-none rounded object-cover"
                />
              ) : (
                <Hatch class="w-14 h-14 flex-none" />
              )
            }
            <div class="flex-1 min-w-0">
              <Tag muted={item.muted}>{item.tag}</Tag>
              <div class="mt-2 font-mono text-[15px] text-foreground group-hover:text-primary transition-colors font-bold leading-snug">
                {item.label}
              </div>
              <div class="mt-1 text-[13px] font-mono text-muted-foreground line-clamp-1">
                {item.sub}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    {/* Quick nav cards */}
    <div class="grid grid-cols-3 gap-4">
      {
        navCards.map((id) => (
          <a
            href={`/${id}`}
            class="bg-card border border-border rounded p-4 text-left hover:border-primary/50 hover:bg-primary/5 transition-all group block"
          >
            <div class="text-[14px] font-mono text-muted-foreground mb-1">→</div>
            <div class="font-bold font-mono text-[16px] text-foreground group-hover:text-primary transition-colors">
              {id}
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
