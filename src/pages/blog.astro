---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/astro/PostList.astro";
import Pagination from "../components/astro/Pagination.astro";
import { getBlogPosts, getFeaturedPost } from "../lib/content";
import { paginate, BLOG_PAGE_SIZE, blogPagePath } from "../lib/pagination";

// Page 1 of the archive. Later pages live at /blog/page/N — see
// src/pages/blog/page/[page].astro, which shares these components so the two
// routes cannot present the list differently.
//
// Same featured rule as the home page; it lives in src/lib/content.ts so the
// two pages cannot disagree about which post is the hero. The hero shows on
// page 1 only, and is held out of the paged list so it never appears twice.
const [posts, featured] = await Promise.all([getBlogPosts(), getFeaturedPost()]);
const rest = posts.filter((p) => p.id !== featured?.id);
const page = paginate(rest, { pageSize: BLOG_PAGE_SIZE, pathFor: blogPagePath })[0]!;
---

<Layout title="blog">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="font-bold font-mono text-[32px] text-foreground mb-3">blog</h1>
    <p class="text-[15px] font-mono text-muted-foreground mb-8">
      homelab notes · computing deep-dives · gaming-adjacent things · personal opinions
    </p>

    {/* Featured */}
    {
      featured && (
        <a
          href={`/blog/${featured.id}`}
          class="block bg-card border border-border rounded overflow-hidden mb-8 hover:border-primary/50 transition-colors group"
        >
          <div class="p-5">
            <div class="flex gap-2 items-center mb-3">
              <span class="text-[12px] font-mono text-primary border border-primary rounded px-1.5 py-0.5">
                FEATURED
              </span>
              <span class="text-[12px] font-mono text-muted-foreground">
                <time datetime={featured.data.date}>{featured.data.date}</time> ·{" "}
                {featured.data.readTime} · {featured.data.category}
              </span>
            </div>
            <div class="font-bold font-mono text-[18px] text-foreground group-hover:text-primary transition-colors leading-snug mb-2">
              {featured.data.title}
            </div>
            <div class="text-[15px] font-mono text-muted-foreground leading-relaxed">
              {featured.data.excerpt}
            </div>
          </div>
        </a>
      )
    }

    <PostList posts={page.items} />
    <Pagination page={page} pathFor={blogPagePath} label="Blog pages" />
  </main>
</Layout>
