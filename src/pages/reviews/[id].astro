---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import VerdictBadge from "../../components/astro/VerdictBadge.astro";
import { getReviews, getReview } from "../../lib/content";

export async function getStaticPaths() {
  const reviews = await getReviews();
  return reviews.map((review) => ({
    params: { id: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const r = review.data;
const { Content } = await render(review);
---

<Layout title={`${r.name} · packetcraft`} description={r.excerpt}>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <a
      href="/reviews"
      class="inline-block text-[13px] font-mono text-muted-foreground hover:text-foreground transition-colors mb-5 cursor-pointer"
    >
      ← reviews / {r.name}
    </a>

    <div class="text-[12px] font-mono text-muted-foreground mb-2">
      {r.date} · {r.type.toLowerCase()}
    </div>
    <div class="flex items-center gap-3 mb-6">
      <h1 class="font-bold font-mono text-[26px] text-foreground">{r.name}</h1>
      <VerdictBadge verdict={r.verdict} />
    </div>

    {/* The sidebar floats rather than taking a grid column, so it ends with its
        own content and the writeup reflows into the full width underneath it. */}
    <div>
      <aside class="float-right w-80 ml-6 mb-4 bg-card border border-border rounded p-4">
        <div class="text-[12px] font-mono text-muted-foreground mb-3">verdict</div>
        <VerdictBadge verdict={r.verdict} />
        <div class="mt-5 text-[12px] font-mono text-muted-foreground mb-3">meta</div>
        <div class="flex flex-col gap-1.5">
          <div class="text-[13px] font-mono text-foreground/70">
            type: <span class="text-foreground">{r.type}</span>
          </div>
          <div class="text-[13px] font-mono text-foreground/70">
            reviewed: <span class="text-foreground">{r.date}</span>
          </div>
        </div>
      </aside>

      <article class="mdx-content">
        <Content />
      </article>

      <div class="clear-both"></div>
    </div>
  </main>
</Layout>
