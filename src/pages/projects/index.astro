---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import StatusBadge from "../../components/astro/StatusBadge.astro";
import Hatch from "../../components/astro/Hatch.astro";
import { getProjects } from "../../lib/content";

const projects = (await getProjects()).map((p) => ({ id: p.id, ...p.data }));

const filters = [
  { label: "all", id: "all" },
  { label: "shipped", id: "SHIPPED" },
  { label: "in progress", id: "BUILDING" },
  { label: "planned", id: "PLANNED" },
];

const BTN_BASE =
  "text-[13px] font-mono px-3 py-1.5 rounded cursor-pointer transition-colors";
const BTN_ACTIVE = "bg-primary text-white";
const BTN_INACTIVE =
  "border border-border text-muted-foreground hover:border-primary/40 hover:text-foreground";
---

<Layout title="projects">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="font-bold font-mono text-[32px] text-foreground mb-5">projects</h1>

    {/* Filtering is an enhancement: with JavaScript off these buttons do
        nothing and every project stays visible, which is the useful default.
        aria-pressed carries the current selection to assistive tech. */}
    <div
      class="flex gap-2 mb-8 flex-wrap"
      id="project-filters"
      role="group"
      aria-label="Filter projects by status"
    >
      {
        filters.map((f) => (
          <button
            type="button"
            data-filter={f.id}
            aria-pressed={f.id === "all" ? "true" : "false"}
            class:list={[BTN_BASE, f.id === "all" ? BTN_ACTIVE : BTN_INACTIVE]}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="project-grid">
      {
        projects.map((p) => (
          <a
            href={`/projects/${p.id}`}
            data-status={p.status}
            class="block bg-card border border-border rounded overflow-hidden text-left hover:border-primary/50 transition-colors group"
          >
            {/* The screenshot is meaningful — the card text never describes it
                — so it keeps real alt text. No width/height override: Astro
                emits the intrinsic size, giving the browser the true aspect
                ratio while the CSS box (h-32 w-full) fixes rendered height. */}
            {
              p.image ? (
                <Image
                  src={p.image}
                  alt={p.imageAlt ?? `Screenshot of ${p.name}`}
                  class="h-32 w-full object-cover"
                />
              ) : (
                <Hatch class="h-24 w-full" label="screenshot" />
              )
            }
            <div class="p-4">
              <div class="flex items-center justify-between mb-2.5">
                <span class="font-bold font-mono text-[16px] text-foreground group-hover:text-primary transition-colors">
                  {p.name}
                </span>
                <StatusBadge status={p.status} />
              </div>
              <div class="text-[14px] font-mono text-muted-foreground leading-relaxed line-clamp-2">
                {p.description}
              </div>
              <div class="mt-3 text-[12px] font-mono text-muted-foreground">{p.meta}</div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <script>
    const BTN_BASE =
      "text-[13px] font-mono px-3 py-1.5 rounded cursor-pointer transition-colors";
    const BTN_ACTIVE = "bg-primary text-white";
    const BTN_INACTIVE =
      "border border-border text-muted-foreground hover:border-primary/40 hover:text-foreground";

    const btns = Array.from(
      document.querySelectorAll<HTMLElement>("#project-filters [data-filter]"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("#project-grid [data-status]"),
    );

    for (const btn of btns) {
      btn.addEventListener("click", () => {
        const f = btn.dataset.filter;
        for (const b of btns) {
          const active = b === btn;
          b.className = `${BTN_BASE} ${active ? BTN_ACTIVE : BTN_INACTIVE}`;
          b.setAttribute("aria-pressed", String(active));
        }
        for (const card of cards) {
          const show = f === "all" || card.dataset.status === f;
          card.classList.toggle("hidden", !show);
        }
      });
    }
  </script>
</Layout>
