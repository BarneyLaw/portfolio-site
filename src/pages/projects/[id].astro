---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/astro/Comments.astro";
import CodeCopy from "../../components/astro/CodeCopy.astro";
import StatusBadge from "../../components/astro/StatusBadge.astro";
import Tag from "../../components/astro/Tag.astro";
import TerminalSnippet from "../../components/astro/TerminalSnippet.astro";
import { getProjects, socialImageOf } from "../../lib/content";
import { externalLinkAttrs } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Layout title={p.name} description={p.description} image={socialImageOf(project)}>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <a
      href="/projects"
      class="inline-block text-[13px] font-mono text-muted-foreground hover:text-foreground transition-colors mb-5 cursor-pointer"
    >
      ← projects / {p.name}
    </a>

    <div class="flex items-center gap-3 mb-3">
      <h1 class="font-bold font-mono text-[26px] text-foreground">{p.name}</h1>
      <StatusBadge status={p.status} />
    </div>

    <div class="flex gap-2 flex-wrap mb-6">
      {p.tags.map((t) => <Tag>{t}</Tag>)}
    </div>

    {/* Demo embed — gap: live demo/status via Go backend (src/lib/api.ts) */}
    <!-- <div
      class="h-48 border-2 border-dashed border-primary rounded-md flex flex-col items-center justify-center gap-3 mb-8 bg-primary/5"
    >
      <div class="flex gap-1">
        {
          [0, 1, 2].map((i) => (
            <div
              class="w-2 h-2 rounded-full bg-primary"
              style={`animation: blink 1.2s steps(1) ${i * 0.4}s infinite`}
            />
          ))
        }
      </div>
      <div class="text-[13px] font-mono text-primary">demo loading…</div>
    </div> -->

    {/* The sidebar floats rather than taking a grid column, so it ends with its
        own content and the writeup reflows into the full width underneath it. */}
    <div>
      <aside class="w-full mb-6 md:float-right md:w-80 md:ml-6 md:mb-4 bg-card border border-border rounded p-4">
        {/* Only rendered when the project actually declares somewhere to go.
            This used to be two hardcoded <span>s that looked like links on
            every project, including the ones with no repo. */}
        {
          p.links.length > 0 && (
            <>
              <div class="text-[12px] font-mono text-muted-foreground mb-3">links</div>
              <div class="flex flex-col gap-2">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    class="text-[14px] font-mono text-primary hover:underline"
                    {...externalLinkAttrs(l.href)}
                  >
                    {l.label}
                    <span aria-hidden="true"> ↗</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ))}
              </div>
              <div class="mt-5" />
            </>
          )
        }
        <div class="text-[12px] font-mono text-muted-foreground mb-3">meta</div>
        <div class="flex flex-col gap-1.5">
          <div class="text-[13px] font-mono text-foreground/70">
            status: <span class="text-foreground">{p.status}</span>
          </div>
          <div class="text-[13px] font-mono text-foreground/70">
            stack: <span class="text-foreground">{p.tags.join(", ")}</span>
          </div>
        </div>
      </aside>

      <article class="mdx-content">
        <Content />
      </article>

      <div class="mt-5 clear-both">
        <TerminalSnippet code={p.codeSnippet} />
      </div>
    </div>

    {/* Comments are keyed on the entry id, which is what the backend's content
        registry stores. Registered slugs are global across content types, so
        this must stay unique against blog and review ids — a test enforces it. */}
    <Comments slug={project.id} enabled={p.comments} />
  </main>

  <CodeCopy />
</Layout>
